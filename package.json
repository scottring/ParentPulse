{
  "name": "relish",
  "version": "1.0.0",
  "description": "Operating manuals for the people you love",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest",
    "test:run": "vitest run",
    "test:watch": "vitest --watch",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:functions": "cd functions && npm test",
    "test:rules": "firebase emulators:exec --only firestore 'vitest run firestore-rules/'",
    "test:all": "npm run test:run && npm run test:functions && npm run test:rules",
    "dev:local": "next dev --webpack --hostname 127.0.0.1 --port 3210",
    "test:relish": "vitest run --config vitest.relish.config.ts",
    "postinstall": "node scripts/prepare-auth-runtime.cjs",
    "prebuild": "node scripts/prepare-auth-runtime.cjs && npm run test:auth-runtime",
    "test:auth-runtime": "node --no-experimental-require-module scripts/verify-auth-runtime.cjs"
  },
  "dependencies": {
    "@headlessui/react": "^2.2.9",
    "@heroicons/react": "^2.2.0",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "dotenv": "^17.2.3",
    "firebase": "^13.1.0",
    "firebase-admin": "^14.5.0",
    "lucide-react": "^0.562.0",
    "next": "^16.4.3",
    "openai": "^6.16.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^6.0.0",
    "@playwright/test": "^1.57.0",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.1",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^5.1.2",
    "@vitest/coverage-v8": "^4.0.17",
    "eslint": "^9",
    "eslint-config-next": "^16.4.3",
    "fake-indexeddb": "^6.2.7",
    "happy-dom": "^21.0.4",
    "msw": "^2.12.7",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.0.17"
  },
  "overrides": {
    "@grpc/grpc-js": "1.13.6"
  },
  "engines": {
    "node": "22.x"
  }
}
