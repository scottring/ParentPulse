# Firebase Configuration
# Get these values from Firebase Console > Project Settings > Your apps > Web app
NEXT_PUBLIC_FIREBASE_API_KEY=your_api_key_here
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project_id.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_app_id

# OpenAI Configuration
# Get your API key from https://platform.openai.com/api-keys
# Server only — never prefix this key with NEXT_PUBLIC_.
OPENAI_API_KEY=your_openai_api_key_here
RELISH_AI_MODEL=gpt-4o-mini
RELISH_TRANSCRIPTION_MODEL=gpt-transcribe
# Optional override; otherwise uses RELISH_AI_MODEL.
# RELISH_MANUAL_MODEL=gpt-4o-mini
# Keep false until OpenAI approves and enables ZDR for the actual hosting-key project.
RELISH_VOICE_CHILDREN_ZDR_VERIFIED=false
RELISH_MANUAL_ZDR_VERIFIED=false
# Service account JSON for this Firebase project, configured as a hosting secret.
RELISH_FIREBASE_ADMIN_JSON=
# Explicit HTTPS origins for custom domains. Vercel preview URLs are detected automatically.
RELISH_AI_ORIGINS=https://app.relish.my
# Only for a production build running on your own computer:
# RELISH_LOCAL_AI_ENABLED=true

# Environment
NEXT_PUBLIC_ENV=development
